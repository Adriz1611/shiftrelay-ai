# Agora Console project, server certificate and Murf API dashboard
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
MURF_API_KEY=
MURF_VOICE_ID=Matthew
# HTTPS ingress for /api/tools/* only
PUBLIC_TOOLS_BASE_URL=
# One local operator, strong password and independent 32+ character secret
DEMO_OPERATOR_PASSWORD=
SESSION_SECRET=
# Dedicated demo repository, workflow file, fine-grained GitHub token
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_ID=checkout.yml
GITHUB_DEPLOY_BRANCH=main
GITHUB_TOKEN=
# Optional GitHub username for the operator's review queue
GITHUB_BRIEFING_LOGIN=
# Optional independent signing secret for the GitHub issue-event receiver
GITHUB_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
DATABASE_PATH=.secrets/shiftrelay.sqlite
